---
import Layout from '@/src/layouts/Layout.astro'
import { sanityFetchWithCdn } from '@/utils/sanity.fetch'
import { listingSearch } from '@/src/server/search/listing-state'
import { publishedSearchFetch } from '@/src/server/search/search-client'
import SearchUnavailable from '@/src/components/ui/SearchUnavailable.astro'
import metadataFetch from '@/utils/metadata.fetch'
import Breadcrumbs from '@/src/layouts/Breadcrumbs.astro'
import { PortableTextQuery, type PortableTextValue } from '@/src/components/ui/portable-text'
import Components, { Components_Query, type ComponentsProps } from '@/src/components/Components.astro'
import { getLangFromPath, type Language } from '@/global/languages'
import Listing, {
  Facets_Query,
  Listing_Query,
  type HotelFilterOptions,
  type ListingProps,
} from '@/src/components/hotels/Listing.astro'
import { getOrderClause, type OrderType } from '@/utils/filters'
import { computeFacets } from '@/utils/listing-facets'
import { hotelFacetGroups, type HotelFacet } from '@/utils/hotel-facets'
import { parseHotelParams } from '@/utils/listing-params'
import ContactForm from '@/src/components/global/ContactForm/index.astro'
import type { FormStateTypes } from '@/src/global/types'
import { ImageDataQuery, type ImageDataProps } from '@/src/components/ui/image'

export const ITEMS_PER_PAGE = 16

type FormProps = {
  formHeading?: PortableTextValue
  formParagraph?: PortableTextValue
  formVisualImage?: ImageDataProps
  overrideFormState?: boolean
  formState?: FormStateTypes
}

type Props = NonNullable<Awaited<ReturnType<typeof fetchData>>> & {
  currentPage: number
  canonicalUrl?: string
  doNotIndex?: boolean
}

type FacetData = Pick<HotelFilterOptions, 'locations' | 'surroundings' | 'cities'> & {
  hotels: HotelFacet[]
  config: Omit<HotelFilterOptions, 'locations' | 'surroundings' | 'cities'> | null
}

export async function fetchData(lang: Language, pageNumber: number, _url: string, searchParams?: URLSearchParams) {
  const urlParams = searchParams || new URLSearchParams()
  const searchQuery = urlParams.get('search')?.trim()
  const PAGINATION_BEFORE = ITEMS_PER_PAGE * (pageNumber - 1)
  const PAGINATION_AFTER = PAGINATION_BEFORE + ITEMS_PER_PAGE

  const params = parseHotelParams(urlParams)

  // In search mode, if no order specified, default to searchMatching
  const order = (urlParams.get('order') as OrderType | null) ?? (searchQuery ? 'searchMatching' : null)

  const orderClause = getOrderClause(order, !!searchQuery, 'hotels')
  const searchState = await listingSearch(searchQuery, 'hotels', lang)
  const fetchPage = searchState.isSearch ? publishedSearchFetch : sanityFetchWithCdn

  const cityPoint = params.city
    ? await fetchPage<{ lat: number; lng: number } | null>({
        query: `*[_type == 'FilterCities_Collection' && language == $language && slug.current == $city][0].point { lat, lng }`,
        params: { language: lang, city: params.city },
        tag: 'page.hotels-list.city',
      })
    : null

  const facets = await fetchPage<FacetData>({
    query: `{ ${Facets_Query} }`,
    params: { language: lang, cityPoint },
    tag: 'page.hotels-list.facets',
  })

  const { hotels, config, ...options } = facets
  if (!config) return null

  // An unknown city or a radius outside the list means no distance filter at all
  const hasDistance = cityPoint !== null && config.distanceRadii.includes(params.radius ?? 0)
  const selected = hasDistance ? params : { ...params, city: null, radius: null }

  const candidateIds = searchState.candidates && new Set(searchState.candidates.map((item) => item.value.documentId))
  const { matchingIds, counts } = computeFacets(
    candidateIds ? hotels.filter((hotel) => candidateIds.has(hotel._id)) : hotels,
    hotelFacetGroups(selected, { ...options, ...config })
  )

  const page = await fetchPage<
    {
      name: string
      slug: string
      globalFormDefaults?: {
        heading?: PortableTextValue
        paragraph?: PortableTextValue
      }
      heading: PortableTextValue
      paragraph: PortableTextValue
      checklist: string[]
      components: ComponentsProps
      noResults: {
        components: ComponentsProps
      }
      escapeHatchHeading?: string
      escapeHatchText?: string
    } & Pick<ListingProps, 'heading' | 'paragraph' | 'checklist' | 'listing'> &
      FormProps
  >({
    query: `
      *[_type == "Hotels_Page" && language == $language][0] {
        name,
        "slug": slug.current,
        "globalFormDefaults": *[_type == "global" && language == $language][0].inquiryFormDefaults {
          ${PortableTextQuery('heading')}
          ${PortableTextQuery('paragraph')}
        },
        ${PortableTextQuery('heading')}
        ${PortableTextQuery('paragraph')}
        ${PortableTextQuery('formHeading')}
        ${PortableTextQuery('formParagraph')}
        ${ImageDataQuery('formVisualImage')}
        escapeHatchHeading,
        escapeHatchText,
        overrideFormState,
        formState {
          success {
            ${PortableTextQuery('heading')}
            ${PortableTextQuery('paragraph')}
            highlightedSocialMedia[] -> {
              name,
              link,
              iconString,
            },
          },
          error {
            ${PortableTextQuery('heading')}
            ${PortableTextQuery('paragraph')}
          },
        },
        checklist[],
        noResults {
          ${Components_Query}
        },
        ${Listing_Query(orderClause)}
        ${Components_Query}
      }
    `,
    params: {
      language: lang,
      PAGINATION_BEFORE,
      PAGINATION_AFTER,
      matchingIds,
      embeddingResults: searchState.candidates,
    },
    tag: 'page.hotels-list',
  })

  if (!page || (!searchState.unavailable && pageNumber > 1 && !page.listing.length)) return null
  const metadata = await metadataFetch(page.slug)
  return {
    page,
    metadata,
    searchUnavailable: searchState.unavailable,
    totalItems: matchingIds.length,
    filterOptions: { ...options, ...config },
    counts,
    selected,
  }
}

export async function staticPaths(lang: Language) {
  const totalHotels = await sanityFetchWithCdn<number>({
    query: `count(*[_type == "Hotels_Collection" && language == $language])`,
    params: { language: lang },
    tag: 'page.hotels-list.count',
  })

  const totalPages = Math.ceil(totalHotels / ITEMS_PER_PAGE)

  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: (i + 2).toString() },
  }))
}

const {
  page,
  searchUnavailable,
  metadata: _metadata,
  totalItems,
  filterOptions,
  counts,
  selected,
  currentPage,
  canonicalUrl,
  doNotIndex,
} = Astro.props
const lang = getLangFromPath(Astro.url.pathname) as Language

const translation = {
  pl: {
    pageUpper: 'Strona',
    pageLower: 'strona',
    prefix: '/pl/hotele',
    sort: {
      popularity: 'Najpopularniejsze',
      priceDesc: 'Cena: od najwyższej',
      priceAsc: 'Cena: od najniższej',
      newest: 'Od najnowszych',
    },
  },
  en: {
    pageUpper: 'Page',
    pageLower: 'page',
    prefix: '/en/hotels',
    sort: {
      popularity: 'Most popular',
      priceDesc: 'Price: highest first',
      priceAsc: 'Price: lowest first',
      newest: 'Newest first',
    },
  },
} as const

const t = translation[lang as keyof typeof translation]
const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE)

const metadata = {
  ..._metadata,
  title: currentPage > 1 ? `${_metadata.title} – ${t.pageUpper} ${currentPage}` : _metadata.title,
  description: _metadata.description,
  openGraphImage: _metadata.openGraphImage,
  path: Astro.url.pathname,
  ...(canonicalUrl && { canonicalUrl }),
  ...(doNotIndex && { doNotIndex }),
}

const getPaginationUrl = (page: number) => {
  return `${t.prefix}/${t.pageLower}/${page}`
}

const breadcrumbs = [
  { name: page.name, path: page.slug },
  ...(currentPage > 1 ? [{ name: `${t.pageUpper} ${currentPage}`, path: getPaginationUrl(currentPage) }] : []),
]

const filteredComponents = (page.components || []).filter((c) => c._type !== 'ContactForm')
const resolvedFormHeading = page.formHeading || page.globalFormDefaults?.heading
const resolvedFormParagraph = page.formParagraph || page.globalFormDefaults?.paragraph
---

<Layout {...metadata}>
  <Fragment slot="Head">
    {!searchUnavailable && currentPage > 1 && <link rel="prev" href={getPaginationUrl(currentPage - 1)} />}
    {!searchUnavailable && currentPage < totalPages && <link rel="next" href={getPaginationUrl(currentPage + 1)} />}
  </Fragment>

  <Breadcrumbs data={breadcrumbs} firstItemType="HotelsListing" />
  {searchUnavailable ? <SearchUnavailable /> : <Listing
    heading={page.heading}
    paragraph={page.paragraph}
    totalItems={totalItems}
    listing={page.listing}
    currentPage={currentPage}
    filterOptions={filterOptions}
    counts={counts}
    selected={selected}
    checklist={page.checklist}
    escapeHintText={page.escapeHatchHeading}
    escapeHintCta={page.escapeHatchText}
  />}
  {resolvedFormHeading && (
    <ContactForm
      index={10}
      sectionId={lang === 'pl' ? 'kontakt' : 'contact'}
      heading={resolvedFormHeading}
      paragraph={resolvedFormParagraph || []}
      formVisualImage={page.formVisualImage}
      overrideFormState={page.overrideFormState}
      state={page.formState}
      variant="hotel_listing"
      showInquiries={false}
      animate={false}
    />
  )}
  {!searchUnavailable && <Components data={page.listing.length > 0 ? filteredComponents : page?.noResults?.components} hasPreviousSections />}
</Layout>

<script>
  import { trackEvent } from '@/utils/track-event'

  // Track hotels list view
  document.addEventListener('DOMContentLoaded', () => {
    // Get hotel items from the page
    const hotelItems = document.querySelectorAll('.HotelCard') as NodeListOf<HTMLElement>
    if (!hotelItems.length) return

    // Create array of items for tracking
    const items = Array.from(hotelItems)
      .slice(0, 10)
      .map((hotel, index) => {
        const hotelName = hotel.querySelector('.title')?.textContent?.trim() || ''
        const hotelId = hotel.dataset.id || ''
        const hotelPricing = Number(hotel.dataset.pricing || '')

        return {
          item_name: hotelName,
          item_id: hotelId,
          item_price: Number.isFinite(hotelPricing) ? hotelPricing : undefined,
          price: Number.isFinite(hotelPricing) ? hotelPricing : undefined,
          index,
        }
      })

    if (items.length > 0) {
      const contentIds = items.map((item) => item.item_id).filter(Boolean) as string[]
      trackEvent({
        ga4: {
          eventName: 'view_item_list',
          params: {
            items,
            item_list_name: 'Hotels Listing',
          },
        },
        meta: {
          eventName: 'ViewCategory',
          contentName: 'Hotels Listing',
          params: {
            category_name: 'Hotels Listing',
            content_ids: contentIds.length ? contentIds : undefined,
          },
        },
      })
    }
  })
</script>
