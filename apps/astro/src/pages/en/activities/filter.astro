---
export const prerender = false

import ActivitiesListing, { fetchData } from '@/src/templates/activities/CategoriesPage.astro'
import { DOMAIN } from '@/global/constants'
import { joinUrl } from '@/utils/join-url'

const data = await fetchData('en', DOMAIN, Astro.url.searchParams)

// Calculate canonical URL (remove /filter from current path)
const canonicalUrl = joinUrl(DOMAIN, '/en/activities/')

if (!data) return Astro.rewrite('/en/404')
---

<ActivitiesListing {...data} canonicalUrl={canonicalUrl} doNotIndex={true} />

