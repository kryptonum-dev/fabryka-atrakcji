---
export const prerender = false

import EventSpacesListing, { fetchData } from '@/src/templates/event-spaces/EventSpacesPage.astro'
import { DOMAIN } from '@/global/constants'

const data = await fetchData('en', 1, DOMAIN)

if (!data) return Astro.rewrite('/en/404')
---

<EventSpacesListing {...data} currentPage={1} />
