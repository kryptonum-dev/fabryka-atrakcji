---
export const prerender = false

import ActivitiesListing, { fetchData } from '@/src/templates/activities/CategoriesPage.astro'
import { DOMAIN } from '@/global/constants'
import { joinUrl } from '@/utils/join-url'

const data = await fetchData('pl', DOMAIN, Astro.url.searchParams)

// Calculate canonical URL (remove /filtr from current path)
const canonicalUrl = joinUrl(DOMAIN, '/pl/integracje/')

if (!data) return Astro.rewrite('/pl/404')
---

<ActivitiesListing {...data} canonicalUrl={canonicalUrl} doNotIndex={true} />
