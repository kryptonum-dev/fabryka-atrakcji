---
export const prerender = false

import EventSpacesListing, { fetchData } from '@/src/templates/event-spaces/EventSpacesPage.astro'
import { DOMAIN } from '@/global/constants'
import { joinUrl } from '@/utils/join-url'

const data = await fetchData('pl', 1, DOMAIN, Astro.url.searchParams)
const canonicalUrl = joinUrl(DOMAIN, '/pl/przestrzenie-eventowe/')

if (!data) return Astro.rewrite('/pl/404')
---

<EventSpacesListing {...data} currentPage={1} canonicalUrl={canonicalUrl} doNotIndex={true} />
