---
import { DOMAIN } from '@/global/constants'
import { joinUrl } from '@/utils/join-url'
import type { Language } from '@/global/languages'

export type BlogSchema = {
  title: string
  description: string
  publishDate: string
  updatedDate: string
  content: string
  image: string
  /** Page path (e.g. `/pl/blog/slug/`); absolutised against DOMAIN below. */
  url: string
  lang: Language
}

const { title, description, publishDate, updatedDate, image, url, content, lang } = Astro.props as BlogSchema

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: [image],
  datePublished: publishDate,
  dateModified: updatedDate,
  articleBody: content,
  author: {
    '@type': 'ProfessionalService',
    name: 'Fabryka Atrakcji',
    '@id': `${DOMAIN}#organization`,
    url: DOMAIN,
  },
  publisher: {
    '@type': 'ProfessionalService',
    name: 'Fabryka Atrakcji',
    '@id': `${DOMAIN}#organization`,
    url: DOMAIN,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': joinUrl(DOMAIN, url),
  },
  inLanguage: lang,
  wordCount: content.split(/\s+/).filter((word) => word.length > 0).length,
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
