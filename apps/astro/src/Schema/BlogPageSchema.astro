---
import { DOMAIN } from '@/global/constants'
import { joinUrl } from '@/utils/join-url'

export type BlogPageSchemaProps = {
  name: string
  description?: string
  /** Page path (e.g. `/pl/blog/`); absolutised against DOMAIN below. */
  url: string
  posts?: {
    name: string
    title: string
    /** Post path (e.g. `/pl/blog/slug/`); absolutised against DOMAIN below. */
    url: string
    description?: string
    image?: string
    datePublished?: string
  }[]
}

const { name, description, url, posts } = Astro.props as BlogPageSchemaProps

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${DOMAIN}#blog`,
  name,
  description,
  url: joinUrl(DOMAIN, url),
  ...(posts && {
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'BlogPosting',
          '@id': joinUrl(DOMAIN, post.url),
          name: post.name,
          headline: post.title,
          url: joinUrl(DOMAIN, post.url),
          ...(post.description && { description: post.description }),
          ...(post.image && { image: [post.image] }),
          ...(post.datePublished && { datePublished: post.datePublished }),
          author: {
            '@type': 'ProfessionalService',
            name: 'Fabryka Atrakcji',
            '@id': `${DOMAIN}#organization`,
            url: DOMAIN,
          },
          publisher: {
            '@type': 'ProfessionalService',
            name: 'Fabryka Atrakcji',
            '@id': `${DOMAIN}#organization`,
            url: DOMAIN,
          },
        },
      })),
    },
  }),
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
