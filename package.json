{
  "name": "fabryka-atrakcji",
  "author": {
    "name": "Oliwier Sellig",
    "email": "oliwier@kryptonum.eu",
    "url": "https://kryptonum.eu/pl"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "groq": "^5.9.0",
    "turbo": "^2.8.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.4",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo build",
    "dev": "dotenv -- turbo dev",
    "lint": "dotenv -- turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:search": "bun test tests/search",
    "search:embeddings": "dotenv -- bun apps/sanity/scripts/dataset-embeddings.ts",
    "search:evaluate": "dotenv -- bun apps/sanity/scripts/evaluate-search.ts"
  },
  "workspaces": [
    "apps/*"
  ]
}
